<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="28dp"
    android:paddingEnd="28dp"
    android:paddingTop="24dp"
    android:paddingBottom="20dp">

    <TextView
        android:id="@+id/pinTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFFFF"
        android:textSize="22sp" />

    <TextView
        android:id="@+id/pinDots"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center"
        android:letterSpacing="0.35"
        android:textColor="#FFFFFFFF"
        android:textSize="28sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="horizontal">
        <TextView android:id="@+id/pin1" style="@style/PinKey" android:text="1" />
        <TextView android:id="@+id/pin2" style="@style/PinKey" android:text="2" />
        <TextView android:id="@+id/pin3" style="@style/PinKey" android:text="3" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">
        <TextView android:id="@+id/pin4" style="@style/PinKey" android:text="4" />
        <TextView android:id="@+id/pin5" style="@style/PinKey" android:text="5" />
        <TextView android:id="@+id/pin6" style="@style/PinKey" android:text="6" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">
        <TextView android:id="@+id/pin7" style="@style/PinKey" android:text="7" />
        <TextView android:id="@+id/pin8" style="@style/PinKey" android:text="8" />
        <TextView android:id="@+id/pin9" style="@style/PinKey" android:text="9" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">
        <TextView android:id="@+id/pinClear" style="@style/PinKey" android:text="@string/watch_timer_clear" />
        <TextView android:id="@+id/pin0" style="@style/PinKey" android:text="0" />
        <TextView android:id="@+id/pinForgot" style="@style/PinKey" android:text="@string/watch_timer_forgot" />
    </LinearLayout>
</LinearLayout>
